# Copia este archivo a ".env" y completa tus credenciales reales.
# NUNCA subas el archivo ".env" (con claves reales) al repositorio.

# Fuente de scouting activa: "rapidapi" (default, tiene planes free/baratos)
# o "keepa" (100% de pago, desde 49EUR/mes -- solo si ya pagas esa suscripcion).
SCOUTING_SOURCE=rapidapi

# --- Keepa (https://keepa.com/#!api) --- OPCIONAL, sin plan gratis, omitir si SCOUTING_SOURCE=rapidapi
KEEPA_API_KEY=

# --- RapidAPI (https://rapidapi.com/hub) ---
# Usa la key de tu cuenta de RapidAPI y el "host" del endpoint concreto
# que suscribas (ej. un API de "Amazon Data" en el marketplace de RapidAPI).
RAPIDAPI_KEY=
RAPIDAPI_AMAZON_HOST=real-time-amazon-data.p.rapidapi.com

# --- CJdropshipping (https://developers.cjdropshipping.com/) ---
CJ_API_KEY=
CJ_API_SECRET=

# --- Anthropic / Claude (https://console.anthropic.com/) ---
ANTHROPIC_API_KEY=
# Modelo a usar para generar variantes de búsqueda y validar matches.
# Ajusta este valor a un ID de modelo vigente en tu cuenta.
ANTHROPIC_MODEL=claude-sonnet-5

# --- Parámetros de negocio ---
AMAZON_COMMISSION_PCT=15
MIN_GAP_PCT=50

# --- Modo de ejecución ---
# TEST_MODE=true usa datos hardcodeados (scouting/sample_data.py) y NO llama
# a las APIs externas, para depurar la lógica sin gastar cuota.
TEST_MODE=true
